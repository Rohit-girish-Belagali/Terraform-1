 "rules": [
  {
   "id": "R-SANDY-1",
   "type": "diagnostic",
   "archetype": "ARC-SANDY",
   "when": {
    "all": [
     "F-GRITTY"
    ]
   },
   "concludes": "Sandy texture. Texture is not by itself degradation; confirm low organic matter before diagnosing degradation.",
   "min_evidence": 1,
   "status": "pending_review"
  },
  {
   "id": "R-SALINE-1",
   "type": "diagnostic",
   "archetype": "ARC-SALINE",
   "when": {
    "any": [
     "F-SALT-CRUST",
     "F-SALT-SMELL"
    ],
    "also_any": [
     "F-STUNTED-BROWN",
     "F-SEA-NEAR"
    ]
   },
   "concludes": "Probable salinity. Salinity can only be confirmed by an EC measurement.",
   "min_evidence": 2,
   "status": "pending_review"
  },
