  {
   "id": "RC-CRUMB",
   "name": "Crumb structure test",
   "applies_to": [
    "ARC-SANDY",
    "ARC-ARID",
    "ARC-COMPACTED",
    "ARC-DISTURBED",
    "ARC-WATERLOGGED"
