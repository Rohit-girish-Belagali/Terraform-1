 "procedures": [
  {
   "id": "PROC-DRAINAGE",
   "name": "Drainage correction",
   "applies_to": [
    "ARC-WATERLOGGED"
   ],
   "targets": [
    "standing water",
    "slow drainage"
   ],
   "prerequisites": [],
   "materials": [
    "channels or drains, raised beds"
   ],
   "rate": "Channels about 30 cm wide and 30 cm deep, spaced 5-10 m apart, falling toward an outlet",
   "unit": "",
   "steps": [
    "Dig channels from low patches toward an outlet.",
    "Do not plant until surface water is gone.",
    "Let soil dry until it crumbles rather than smears."
   ],
   "verification": [
    "No standing water",
    "Infiltration check",
    "Crumb test"
   ],
   "stabilization_days": 7,
   "phase": "A",
   "status": "pending_review",
   "source": "SRC-CASE"
  }
 ],
