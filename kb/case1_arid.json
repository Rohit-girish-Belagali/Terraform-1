 "rules": [
  {
   "id": "R-ARID-1",
   "type": "diagnostic",
   "archetype": "ARC-ARID",
   "when": {
    "all": [
     "F-NO-VEG"
    ],
    "any": [
     "F-CRACKED",
     "F-RAIN-RARE",
     "F-HIGH-HEAT"
    ]
   },
   "concludes": "Drought stress with poor moisture retention",
   "min_evidence": 2,
   "status": "pending_review"
  },
