 "readiness_criteria": [
  {
   "id": "RC-CRUMB",
   "name": "Crumb structure test",
   "applies_to": [
    "ARC-SANDY",
    "ARC-ARID",
    "ARC-COMPACTED",
    "ARC-DISTURBED",
    "ARC-WATERLOGGED"
   ],
   "check": "A handful of soil holds together and breaks into crumbs rather than falling apart as dust or smearing as paste.",
   "mandatory": true,
   "if_failed": "Add organic matter or let soil dry, then repeat."
  },
  {
   "id": "RC-INFIL",
   "name": "Infiltration check",
   "applies_to": [
    "ARC-WATERLOGGED",
    "ARC-COMPACTED",
    "ARC-DISTURBED"
   ],
   "check": "Water poured on the surface soaks in without pooling.",
   "mandatory": true,
   "if_failed": "Repeat drainage or decompaction."
  },
  {
   "id": "RC-NOPOOL",
   "name": "No standing water",
   "applies_to": [
    "ARC-WATERLOGGED"
   ],
   "check": "No standing puddles on the plot.",
   "mandatory": true,
   "if_failed": "Continue drainage correction."
  },
  {
   "id": "RC-MOIST",
   "name": "Moisture retention",
   "applies_to": [
    "ARC-SANDY",
    "ARC-ARID"
   ],
   "check": "Soil stays damp below the surface after watering.",
   "mandatory": true,
   "if_failed": "Add organic matter and mulch."
  },
  {
   "id": "RC-DUST",
   "name": "Surface stability",
   "applies_to": [
    "ARC-ARID",
    "ARC-SANDY",
    "ARC-SALINE"
   ],
   "check": "Wind no longer lifts loose soil from the surface.",
   "mandatory": true,
   "if_failed": "Add windbreak or ground cover."
  },
  {
   "id": "RC-SALT",
   "name": "Salt crust cleared",
   "applies_to": [
    "ARC-SALINE"
   ],
   "check": "No visible crust and a measured EC reading is available.",
   "mandatory": true,
   "if_failed": "Provide an EC reading or continue salinity management."
  },
  {
   "id": "RC-STAB",
   "name": "Stabilization window",
   "applies_to": [
    "ARC-SANDY",
    "ARC-ARID",
    "ARC-COMPACTED",
    "ARC-DISTURBED"
   ],
   "check": "Required waiting time after amendments has passed.",
   "mandatory": true,
   "window_days": 3,
   "if_failed": "Wait for the stabilization window to pass, then repeat."
  }
 ],
 "crops": [
