 "archetypes": [
  {
   "id": "ARC-SANDY",
   "name": "Sandy / Loamy Sand (Degraded)",
   "criteria": "Gritty, loose texture; low cohesion; rapid drainage.",
   "physical_profile": "Loose, particulate, low aggregate stability",
   "core_gaps": [
    "low water-holding capacity",
    "low organic matter",
    "low nutrient retention"
   ],
   "typical_estimates": {
    "texture_class": "Sand / loamy sand",
    "drainage": "Excessive",
    "ph_range": "5.5-7.0",
    "organic_matter": "Low",
    "cec": "Low"
   },
   "estimate_label": "estimate, not laboratory measurement",
   "status": "pending_review",
   "source": "SRC-AGRI-GEN"
  },
  {
   "id": "ARC-ARID",
   "name": "Arid / Drought-Stressed",
   "criteria": "Dry, low organic matter, poor moisture retention, unreliable rain.",
   "variants": [
    "cracked-compacted (retention dominant)",
    "loose-eroding (wind erosion dominant)"
   ],
   "core_gaps": [
    "water scarcity",
    "wind erosion",
    "poor structure"
   ],
   "status": "pending_review",
   "source": "SRC-CASE",
   "typical_estimates": {
    "texture_class": "Clay-loam crust to loose sand",
    "drainage": "Poor when crusted, rapid when sandy",
    "organic_matter": "Low",
    "cec": "Low to moderate",
    "ph_range": "7.0-8.5"
   }
  },
  {
   "id": "ARC-WATERLOGGED",
   "name": "Waterlogged / Poorly Drained",
   "criteria": "Standing water or slow drainage; sour smell; oxygen-starved root zone.",
   "variants": [
    "recently flooded (days)",
    "prolonged waterlogging",
    "heavy slow-draining without visible pooling"
   ],
   "core_gaps": [
    "drainage",
    "root-zone oxygen",
    "nutrient loss",
    "disease risk"
   ],
   "status": "pending_review",
   "source": "SRC-CASE",
   "typical_estimates": {
    "texture_class": "Clay / silty clay",
    "drainage": "Very poor",
    "organic_matter": "Moderate, partly decomposed",
    "cec": "Moderate to high",
    "ph_range": "5.5-6.5"
   }
  },
  {
   "id": "ARC-SALINE",
   "name": "Saline / Salt-Affected",
   "criteria": "Salt crust or salty air, stunted browning plants, coastal context.",
   "variants": [
    "visible crust",
    "no crust but salty smell and stunting",
    "salt spray without saline soil"
   ],
   "core_gaps": [
    "salinity",
    "wind exposure",
    "low water retention if sandy"
   ],
   "status": "pending_review",
   "source": "SRC-CASE",
   "typical_estimates": {
    "texture_class": "Sand / loamy sand",
    "drainage": "Rapid",
    "organic_matter": "Low",
    "cec": "Low",
    "ph_range": "7.5-8.5"
   }
  },
  {
   "id": "ARC-COMPACTED",
   "name": "Compacted and Depleted",
   "criteria": "Hard-packed ground, poor infiltration, bare or thin grazed vegetation, low organic matter.",
   "variants": [
    "uniform",
    "uneven wear"
   ],
   "core_gaps": [
    "compaction",
    "poor infiltration",
    "nutrient and organic matter depletion"
   ],
   "status": "pending_review",
   "source": "SRC-CASE",
   "typical_estimates": {
    "texture_class": "Compacted loam / clay loam",
    "drainage": "Poor infiltration",
    "organic_matter": "Low",
    "cec": "Moderate",
    "ph_range": "5.5-7.0"
   }
  },
  {
   "id": "ARC-DISTURBED",
   "name": "Disturbed, Compacted, Sun-Exposed",
   "criteria": "Cleared land with tracks, stumps or debris; no canopy; compacted.",
   "core_gaps": [
    "compaction",
    "heat and sun exposure",
    "no surface cover"
   ],
   "status": "pending_review",
   "source": "SRC-CASE",
   "typical_estimates": {
    "texture_class": "Compacted loam / clay loam",
    "drainage": "Poor infiltration",
    "organic_matter": "Low (topsoil lost)",
    "cec": "Low to moderate",
    "ph_range": "5.5-7.0"
   }
  }
 ],
 "rules": [
  {
   "id": "R-ARID-1",
   "type": "diagnostic",
   "archetype": "ARC-ARID",
   "when": {
    "all": [
     "F-NO-VEG"
    ],
    "any": [
     "F-CRACKED",
     "F-RAIN-RARE",
     "F-HIGH-HEAT"
    ]
   },
   "concludes": "Drought stress with poor moisture retention",
   "min_evidence": 2,
   "status": "pending_review"
  },
  {
   "id": "R-ARID-2",
   "type": "diagnostic",
   "archetype": "ARC-ARID",
   "when": {
    "all": [
     "F-LOOSE-DUST"
    ],
    "any": [
     "F-NO-VEG",
     "F-GRITTY",
     "F-CRACKED"
    ]
   },
   "concludes": "Active wind erosion in addition to dryness",
   "min_evidence": 2,
   "status": "pending_review"
  },
  {
   "id": "R-SANDY-1",
   "type": "diagnostic",
   "archetype": "ARC-SANDY",
   "when": {
    "all": [
     "F-GRITTY"
    ]
   },
   "concludes": "Sandy texture. Texture is not by itself degradation; confirm low organic matter before diagnosing degradation.",
   "min_evidence": 1,
   "status": "pending_review"
  },
  {
   "id": "R-WET-1",
   "type": "diagnostic",
   "archetype": "ARC-WATERLOGGED",
   "when": {
    "any": [
     "F-STANDING-WATER",
     "F-SLOW-DRAIN"
    ],
    "also_any": [
     "F-SOUR-SMELL",
     "F-YELLOW-WEEDS",
     "F-DARK-STICKY"
    ]
   },
   "concludes": "Waterlogging with root-zone oxygen stress",
   "min_evidence": 2,
   "status": "pending_review"
  },
  {
   "id": "R-SALINE-1",
   "type": "diagnostic",
   "archetype": "ARC-SALINE",
   "when": {
    "any": [
     "F-SALT-CRUST",
     "F-SALT-SMELL"
    ],
    "also_any": [
     "F-STUNTED-BROWN",
     "F-SEA-NEAR"
    ]
   },
   "concludes": "Probable salinity. Salinity can only be confirmed by an EC measurement.",
   "min_evidence": 2,
   "status": "pending_review"
  },
  {
   "id": "R-COMP-1",
   "type": "diagnostic",
   "archetype": "ARC-COMPACTED",
   "when": {
    "any": [
     "F-HARD-PACKED",
     "F-SURFACE-POOLING"
    ],
    "also_any": [
     "F-BARE-PATCHES",
     "F-THIN-GRASS"
    ]
   },
   "concludes": "Compaction with depletion from overuse",
   "min_evidence": 2,
   "status": "pending_review"
  },
  {
   "id": "R-DIST-1",
   "type": "diagnostic",
   "archetype": "ARC-DISTURBED",
   "when": {
    "any": [
     "F-STUMPS"
    ],
    "also_any": [
     "F-NO-CANOPY",
     "F-HARD-PACKED"
    ]
   },
   "concludes": "Disturbed, compacted land with sun exposure as a separate stressor",
   "min_evidence": 2,
   "status": "pending_review"
  },
  {
   "id": "R-WATER-SAFETY",
   "legacy_name": "R14",
   "type": "safety_filter",
   "when": {
    "water_access": [
     "unknown",
     "none"
    ]
   },
   "effect": "Restrict crops to those with water_requirement 'low' or 'low-medium'.",
   "configurable": true,
   "status": "pending_review"
  },
  {
   "id": "R-HEAVY-FEEDER",
   "legacy_name": "R13",
   "type": "safety_filter",
   "when": {
    "deficiency_any": [
     "low organic matter",
     "nutrient depletion",
     "low nutrient retention"
    ]
   },
   "effect": "Exclude crops with feeder_class 'heavy' (for example tomato, cucumber).",
   "configurable": true,
   "status": "pending_review"
  },
  {
   "id": "R-READINESS-GATE",
   "legacy_name": "R9",
   "type": "readiness",
   "effect": "Planting is blocked until the readiness criteria for the diagnosed archetype are met. A missing result counts as not passed.",
   "status": "pending_review"
  },
  {
   "id": "R-MIXED",
   "type": "combination",
   "effect": "More than one archetype may be returned when each meets its min_evidence. Never force a single label.",
   "status": "pending_review"
  },
  {
   "id": "R-NO-ESTIMATE-AS-FACT",
   "type": "integrity",
   "effect": "Properties inferred from text or image are labelled 'estimate'. Only user-supplied lab values may be labelled 'measured'.",
   "status": "pending_review"
  }
 ],
